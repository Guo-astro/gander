<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Same shape as the release icon, pointed at the two debug
     drawables: the release definition takes its background from a colour resource,
     and this one needs a drawable so the grid can live there rather than being
     dragged around by foreground parallax. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
