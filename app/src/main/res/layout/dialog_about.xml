<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls because the permission line only reads "None" while the promise
     holds: if it ever names permissions instead, this has to stay readable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/aboutVersion"
            style="@style/Widget.Gander.About.Body"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Version 1.10" />

        <TextView
            style="@style/Widget.Gander.About.Body"
            android:layout_marginTop="10dp"
            android:text="@string/main_subtitle" />

        <!-- The proof rather than the claim: what the installed package actually
             asks Android for, read at runtime so it cannot drift from the truth. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aboutPermissionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_permissions_label"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/aboutPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="None" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_permissions_detail"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Gander.About.Body"
            android:layout_marginTop="18dp"
            android:text="@string/open_with_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <View
            style="@style/Widget.Gander.About.Divider"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/aboutFileTypes"
            style="@style/Widget.Gander.About.Row">

            <TextView
                style="@style/Widget.Gander.About.Row.Title"
                android:text="@string/about_file_types" />

            <TextView
                style="@style/Widget.Gander.About.Row.Subtitle"
                android:text="@string/about_file_types_detail" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutAuthor"
            style="@style/Widget.Gander.About.Row">

            <TextView
                style="@style/Widget.Gander.About.Row.Title"
                android:text="@string/about_made_by" />

            <TextView
                style="@style/Widget.Gander.About.Row.Subtitle"
                android:text="@string/about_made_by_url" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutSource"
            style="@style/Widget.Gander.About.Row">

            <TextView
                style="@style/Widget.Gander.About.Row.Title"
                android:text="@string/about_source" />

            <TextView
                style="@style/Widget.Gander.About.Row.Subtitle"
                android:text="@string/about_source_url" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutLicences"
            style="@style/Widget.Gander.About.Row">

            <TextView
                style="@style/Widget.Gander.About.Row.Title"
                android:text="@string/about_licences" />

            <TextView
                style="@style/Widget.Gander.About.Row.Subtitle"
                android:text="@string/about_licences_detail" />
        </LinearLayout>

        <View style="@style/Widget.Gander.About.Divider" />

        <TextView
            style="@style/Widget.Gander.About.Body"
            android:layout_marginTop="14dp"
            android:text="@string/about_copyright"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
